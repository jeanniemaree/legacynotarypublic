# Google Maps JavaScript API Key (Requires Places & Directions APIs enabled)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# GA4 Measurement ID from analytics.google.com (Admin → Data streams → Web). Example: G-XXXXXXXXXX
# Leave empty until Jeannie creates the property — do not invent an ID.
VITE_GA4_MEASUREMENT_ID=
